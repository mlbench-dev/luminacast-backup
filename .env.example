# === Server ===
APP_ENV=production
APP_SECRET_KEY=
APP_DOMAIN=luminacast.com
ALLOWED_ORIGINS=https://luminacast.com,https://www.luminacast.com

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=luminacast
POSTGRES_USER=luminacast
POSTGRES_PASSWORD=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# === Redis ===
# REDIS_PASSWORD is injected into the redis container via --requirepass and
# must match the password embedded in REDIS_URL below.
REDIS_PASSWORD=change-me-in-env
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# === OpenRouter ===
OPENROUTER_API_KEY=

# Creative-generation models (script + avatar/creative descriptions). Both
# default to anthropic/claude-opus-4.8 in services/creative_models.py.
# Override here to A/B without code. Non-creative classifier/judge calls are
# unaffected.
CAST_GENERATOR_MODEL=anthropic/claude-opus-4.8
CREATIVE_DESCRIPTION_MODEL=anthropic/claude-opus-4.8

# === Fish Audio (cloud TTS) ===
FISH_AUDIO_API_KEY=

# === Cloud render providers ===
# WaveSpeed InfiniteTalk (cloud lipsync) and fal.ai (T2V/I2V, Whisper,
# MuseTalk, body shots, SDXL) replace the decommissioned on-prem GPU box.
WAVESPEED_API_KEY=
FAL_API_KEY=

# === Post-bake lipsync refine ===
# A second pass re-syncs mouth motion to the voice after the first bake.
# Speaking blocks: by default only blocks >=3s are refined. Set this to
# refine EVERY speaking block (above a 0.5s floor) so short blocks no
# longer drift.
SPEAKING_LIPSYNC_REFINE_FOR_ALL=true
# Motion blocks (HOOK / PRODUCT / PRODUCT_DEMO / SOCIAL_PROOF / PIP) bake
# from a text/image prompt and invent mouth motion that doesn't match the
# voice muxed in afterwards. The refine pass corrects that. Master switch
# defaults ON; set to 0 to disable. BLOCK_TYPES is a comma-separated
# allow-list; MAX_DURATION_S is a per-block cost guard (skip if longer).
MOTION_LIPSYNC_REFINE_ENABLED=true
MOTION_LIPSYNC_REFINE_BLOCK_TYPES=HOOK,PRODUCT,PRODUCT_DEMO,SOCIAL_PROOF,PIP
MOTION_LIPSYNC_REFINE_MAX_DURATION_S=20

# === RunPod (fallback render tier — keep configured) ===
RUNPOD_API_KEY=
RUNPOD_VOLUME_ID=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENDPOINT_IS_PUBLIC=false

# === HOSTKEY GPU kill-switch (DECOMMISSIONED) ===
# The on-prem HOSTKEY GPU box is retired. It is disabled when EITHER of the
# flags below is set to its "off" value (the defaults). All render paths then
# route to the cloud providers above. To re-enable HOSTKEY (rollback) set BOTH
# CAST_RENDER_HOSTKEY_DISABLED=false AND HOSTKEY_RENDER_ENABLED=true.
CAST_RENDER_HOSTKEY_DISABLED=true
HOSTKEY_RENDER_ENABLED=false
# Cloud FFmpeg-compose worker (replaces HOSTKEY /api/ffmpeg-compose).
GPU_WORKER_URL=

# === Cloudflare R2 ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=luminacast

# === Stripe ===
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Apify ===
APIFY_API_TOKEN=

# TikTok product resolver actor catalog (optional override).
# Comma-separated entries of "<owner/slug>:<input_field>[:list]". A "[]" suffix
# on the field name wraps the URL in a list (e.g. {"productUrls": [url]}); no
# suffix passes it as a string (e.g. {"url": url}). Leave empty to use the
# in-code verified-working default below. Editing this lets a future actor
# rename be a config change, not a code change.
# Default:
# TIKTOK_RESOLVER_ACTORS=pratikdani/tiktok-shop-scraper:url,pro100chok/tiktok-shop-scraper-usage:productUrls[],cunning_soil/tiktok-shop-product-scraper-mobile-api:productInput
TIKTOK_RESOLVER_ACTORS=
# Per-run memory cap (MB) for resolver Apify calls (cost control).
TIKTOK_RESOLVER_MAX_MEMORY_MB=512

# === Render Ratios (GPU processing time per second of content) ===
BS_ROFORMER_RENDER_RATIO=1.5
FISH_SPEECH_RENDER_RATIO=3.0
INFINITETALK_RENDER_RATIO=6.0

# === Live-cast outline category bias (PR E) ===
# Short-form (<= LIVE_RATIO_MAX_SECONDS) live/standard casts bias toward
# voiceover + b-roll + uploaded product footage and FEWER full avatar-speaking
# blocks. These three are the target share of blocks per category bucket; they
# are renormalized to sum to 1.0, so 30/40/10 and 0.3/0.4/0.1 are equivalent.
#   LIVE_RATIO_AVATAR   — talking head (avatar_speaking / avatar_action)
#   LIVE_RATIO_BROLL    — voice over stock (avatar_voiceover / stock_video / stock_photo)
#   LIVE_RATIO_UPLOADED — uploaded product-asset footage when the product has video
# Defaults: 0.35 / 0.45 / 0.20. The AVATAR share is enforced as a hard cap:
# surplus talking-head blocks (never the hook or CTA) are demoted to voiceover.
LIVE_RATIO_AVATAR=0.35
LIVE_RATIO_BROLL=0.45
LIVE_RATIO_UPLOADED=0.20
# Casts longer than this (seconds) skip the bias (long-form pacing differs).
LIVE_RATIO_MAX_SECONDS=60

# === ElevenLabs (Voice Design — used once to create, Fish Audio handles TTS) ===
ELEVENLABS_API_KEY=

# === Perplexity ===
PERPLEXITY_API_KEY=

# === Sentry ===
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=production

# === Better Stack ===
BETTERSTACK_TOKEN=
BETTERSTACK_DOCKER_TOKEN=

# === Internal Service Auth ===
INTERNAL_SERVICE_SECRET=

# === Captions SSR (Remotion server-side caption overlay render) ===
# Step 11 scaffold: a Node/Remotion service that renders the caption track to
# a transparent overlay so burnt captions match the animated preview. Not yet
# wired into the composer (Step 12). Disabled by default; the composer will
# only call it when CAPTIONS_SSR_ENABLED=true.
CAPTIONS_SSR_ENABLED=false
CAPTIONS_SSR_URL=http://captions-ssr:3030
CAPTIONS_SSR_PORT=3030
# Output format: png-sequence (transparent PNGs) or alpha-video (alpha webm).
CAPTIONS_SSR_FORMAT=png-sequence

# === Caption style (TikTok-style burnt captions) ===
# Defaults for the drawtext caption burn. Each is applied only when the editor
# element doesn't carry its own value, so leaving these unset reproduces the
# best-in-class look (Montserrat Bold, smaller text, bright-yellow active-word
# highlight, white base with black stroke). Sizes/widths are calibrated for the
# 480x848 test canvas and scaled per render. Uncomment to override.
# CAPTION_FONT_SIZE=22
# CAPTION_FONT_FAMILY=Montserrat Bold
# CAPTION_HIGHLIGHT_COLOR=#FFEB3B
# CAPTION_BASE_COLOR=#FFFFFF
# CAPTION_STROKE_COLOR=#000000
# CAPTION_STROKE_WIDTH=2
# Vertical anchor as a fraction of canvas height (0.70 ≈ 30% up from bottom).
# CAPTION_POSITION_Y=0.70

# === TikTok Chat Monitor ===
TIKTOK_SESSION_ID=
ORCHESTRATOR_WS_URL=ws://orchestrator:8000/ws/internal/chat

# === Admin Credentials ===
ADMIN_USERNAME=admin
ADMIN_EMAIL=3gorka72@gmail.com
ADMIN_PASSWORD=Polaroid-017
