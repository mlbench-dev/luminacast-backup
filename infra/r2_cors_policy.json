{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://www.luminacast.com",
          "https://luminacast.com",
          "https://app.luminacast.com",
          "http://localhost:3000",
          "http://localhost:5173",
          "http://localhost:4173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["*"]
      },
      "exposed_headers": ["ETag", "Content-Length", "Content-Type"],
      "max_age_seconds": 3600
    }
  ]
}
