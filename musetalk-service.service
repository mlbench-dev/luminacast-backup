[Unit]
Description=LuminaCast MuseTalk lip-sync service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/musetalk
Environment=MUSETALK_PORT=7861
Environment=PYTHONPATH=/opt/musetalk
ExecStart=/opt/musetalk/venv/bin/uvicorn musetalk_service:app --host 0.0.0.0 --port 7861 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
